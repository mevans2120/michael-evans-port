# Sanity Configuration (Next.js uses NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Site URL for Sanity live preview (local: http://localhost:3000, production: https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Migration token (server-side only)
SANITY_AUTH_TOKEN=your-auth-token

# Live preview token (client-side, optional - only needed for visual editing features)
NEXT_PUBLIC_SANITY_TOKEN=your-public-token

# Sanity Webhook Secret (revalidates cached content and the chatbot corpus)
SANITY_WEBHOOK_SECRET=your-webhook-secret-here

# AI Chatbot (Claude via @ai-sdk/anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Weather API Configuration
# OpenWeatherMap API key for footer weather display
# Sign up at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# Google Analytics
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Get from: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX